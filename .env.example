# ============================================================
#  로컬 실행 설정 (MySQL)
#  이 파일을 복사해서 `.env` 로 저장한 뒤 값을 채우세요.
#    Windows : copy .env.example .env
#    mac/linux: cp .env.example .env
#  .env 는 절대 git 에 커밋하지 마세요 (.gitignore 에 포함됨)
# ============================================================

# --- 서버 ---
PORT=3000

# --- MySQL 접속 정보 ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=webapp
MYSQL_PASSWORD=webapp1234
MYSQL_DATABASE=webapp

# 커넥션 풀 크기 (동시 접속이 많으면 늘리세요)
MYSQL_POOL=10
