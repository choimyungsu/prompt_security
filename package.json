{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "tsx watch src/server/node.ts",
    "start:local": "tsx src/server/node.ts",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "dev:sandbox": "wrangler pages dev dist --d1=DB --local --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:setup": "tsx scripts/db-setup.ts",
    "test:engine": "node tests/engine.test.mjs",
    "test:export": "node tests/export.test.mjs",
    "test:api": "node tests/api.test.mjs",
    "test:api:mysql": "BASE=http://localhost:3000 EXPECT_DIALECT=mysql node tests/api.test.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl -s http://localhost:3000/health"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.14",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "tsx": "^4.23.15",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
